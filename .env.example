# Non-secret runtime configuration. Copy to .env only for local/manual runs.
PLAYWRIGHT_MCP_IMAGE=mcr.microsoft.com/playwright/mcp:v0.0.75
TUNNEL_CLIENT_IMAGE=ghcr.io/openai/tunnel-client:v0.0.10
OPENAI_TUNNEL_ID=tunnel_00000000000000000000000000000000
OPENAI_RUNTIME_API_KEY_FILE=/run/playwright-mcp-aws/openai_runtime_api_key
LOG_LEVEL=info
